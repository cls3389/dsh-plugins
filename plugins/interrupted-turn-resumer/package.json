{
  "name": "@dsh-friends/interrupted-turn-resumer",
  "version": "0.2.2",
  "type": "module",
  "main": "./main.js",
  "exports": {
    ".": "./main.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "main.js",
    "cordis.patch.yml",
    "README.md",
    "test-regressions.mjs",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node --test test-regressions.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "DSH 进程中断恢复后自动续接：监听 interrupted 轮次并补扫，每个轮次最多发送一次继续消息",
  "keywords": [
    "dsh",
    "session",
    "resumer",
    "reliability"
  ],
  "license": "MIT"
}
