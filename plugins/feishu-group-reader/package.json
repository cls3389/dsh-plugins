{
  "name": "@dsh-friends/feishu-group-reader",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
