{
  "name": "@dsh-friends/session-title-keeper",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./main.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "main.js",
    "cordis.patch.yml",
    "locale/*.json",
    "test-regressions.mjs"
  ],
  "scripts": {
    "test": "node test-regressions.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "会话标题增量更新:定时扫描会话日志,把仍停留在 fallback 截断版、或未覆盖最新用户消息的标题用 LLM 重算并写回 session/title 事件",
  "keywords": ["dsh", "session", "title", "llm"],
  "license": "MIT"
}
